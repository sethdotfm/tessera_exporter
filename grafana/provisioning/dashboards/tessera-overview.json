{
  "uid": "tessera-overview",
  "title": "Tessera Overview",
  "description": "Fleet view. One repeated row per processor Prometheus is configured to scrape, reachable or not. Rows key on the 'processor' target label (\"<ip> - <location>\", built by a relabel rule in prometheus.yml) rather than on serial, because serial comes from tessera_info and a processor stops publishing that the moment it goes offline. Click any stat in a row to open the detail dashboard scoped to that processor.",
  "tags": [
    "tessera",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "links": [
    {
      "title": "Tessera Processor Detail",
      "type": "dashboards",
      "tags": [
        "tessera",
        "detail"
      ],
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "description": "Site label from targets/tessera.yml. \"All\" does not filter, so targets with no site label are still included.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "query_result(tessera_up)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": "/site=\"([^\"]+)\"/"
      },
      {
        "name": "location",
        "label": "Location",
        "description": "Location label from targets/tessera.yml. \"All\" does not filter, so targets with no location label are still included.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "query_result(tessera_up{site=~\"${site:pipe}\"})",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": "/location=\"([^\"]+)\"/"
      },
      {
        "name": "processor",
        "label": "Processor",
        "description": "Drives the row repeat. Sourced from tessera_up, which the exporter emits for every configured target whether the probe succeeded or not, so unreachable processors keep their row. Deliberately has no allValue: a repeat variable set to a catch-all would render one row titled \".*\" instead of one row per processor.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "query_result(tessera_up{site=~\"${site:pipe}\", location=~\"${location:pipe}\"})",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "regex": "/processor=\"([^\"]+)\"/"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Processors reachable",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(tessera_up{site=~\"${site:pipe}\", location=~\"${location:pipe}\", processor=~\"${processor:pipe}\"} == 1) or vector(0)",
          "instant": true,
          "legendFormat": "reachable"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(tessera_up{site=~\"${site:pipe}\", location=~\"${location:pipe}\", processor=~\"${processor:pipe}\"}) or vector(0)",
          "instant": true,
          "legendFormat": "configured"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unreachable",
      "description": "Processors whose last probe failed. The exporter emits tessera_up 0 for these, so they still appear as a row below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(tessera_up{site=~\"${site:pipe}\", location=~\"${location:pipe}\", processor=~\"${processor:pipe}\"} == 0) or vector(0)",
          "instant": true,
          "legendFormat": "unreachable"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background_solid",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Panels in error (fleet)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(tessera_devices_statistics_error_count{site=~\"${site:pipe}\", location=~\"${location:pipe}\", processor=~\"${processor:pipe}\"}) or vector(0)",
          "instant": true,
          "legendFormat": "errors"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background_solid",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Hottest sensor per processor",
      "description": "Maximum across every tessera_system_temperature_*_celsius sensor, per processor.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (processor) ({__name__=~\"tessera_system_temperature_.+_celsius\", site=~\"${site:pipe}\", location=~\"${location:pipe}\", processor=~\"${processor:pipe}\"})",
          "legendFormat": "{{processor}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 100,
      "type": "row",
      "title": "$processor",
      "repeat": "processor",
      "repeatDirection": "v",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 101,
      "type": "stat",
      "title": "Status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 3,
        "x": 0,
        "y": 6
      },
      "links": [
        {
          "title": "Open detail for $processor",
          "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
          "targetBlank": false
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tessera_up{processor=\"${processor:raw}\"}",
          "instant": true,
          "legendFormat": "status"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background_solid",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "NO DATA",
          "links": [
            {
              "title": "Open detail for $processor",
              "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "type": "stat",
      "title": "Hottest sensor",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 3,
        "x": 3,
        "y": 6
      },
      "links": [
        {
          "title": "Open detail for $processor",
          "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
          "targetBlank": false
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max({__name__=~\"tessera_system_temperature_.+_celsius\", processor=\"${processor:raw}\"})",
          "instant": true,
          "legendFormat": "max temp"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          },
          "links": [
            {
              "title": "Open detail for $processor",
              "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 103,
      "type": "stat",
      "title": "Panels online",
      "description": "Online out of associated, from the devices collector.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 3,
        "x": 6,
        "y": 6
      },
      "links": [
        {
          "title": "Open detail for $processor",
          "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
          "targetBlank": false
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tessera_devices_statistics_online_count{processor=\"${processor:raw}\"}",
          "instant": true,
          "legendFormat": "online"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tessera_devices_statistics_associated_count{processor=\"${processor:raw}\"}",
          "instant": true,
          "legendFormat": "associated"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "links": [
            {
              "title": "Open detail for $processor",
              "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 104,
      "type": "stat",
      "title": "Panel errors",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 3,
        "x": 9,
        "y": 6
      },
      "links": [
        {
          "title": "Open detail for $processor",
          "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
          "targetBlank": false
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tessera_devices_statistics_error_count{processor=\"${processor:raw}\"}",
          "instant": true,
          "legendFormat": "errors"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "background_solid",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "links": [
            {
              "title": "Open detail for $processor",
              "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "Temperatures",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "links": [
        {
          "title": "Open detail for $processor",
          "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
          "targetBlank": false
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "label_replace({__name__=~\"tessera_system_temperature_.+_celsius\", processor=\"${processor:raw}\"}, \"sensor\", \"$1\", \"__name__\", \"tessera_system_temperature_(.+)_celsius\")",
          "legendFormat": "{{sensor}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 106,
      "type": "table",
      "title": "Identity",
      "description": "From tessera_info. Empty while the processor is unreachable \u2014 the row itself comes from tessera_up, which is always present.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 18,
        "y": 6
      },
      "links": [
        {
          "title": "Open detail for $processor",
          "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
          "targetBlank": false
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "tessera_info{processor=\"${processor:raw}\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "processor": true,
              "site": true,
              "location": true
            },
            "indexByName": {
              "serial": 0,
              "processor_name": 1,
              "processor_type": 2,
              "software_version": 3,
              "project": 4
            },
            "renameByName": {
              "serial": "Serial",
              "processor_name": "Name",
              "processor_type": "Type",
              "software_version": "Version",
              "project": "Project"
            }
          }
        },
        {
          "id": "transpose",
          "options": {
            "firstFieldName": "Field",
            "restFieldsName": "Value"
          }
        }
      ],
      "options": {
        "showHeader": false,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "links": [
            {
              "title": "Open detail for $processor",
              "url": "/d/tessera-detail/tessera-processor-detail?var-processor=${processor:percentencode}&${__url_time_range}",
              "targetBlank": false
            }
          ]
        },
        "overrides": []
      }
    }
  ]
}
